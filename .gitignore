# Python
__pycache__/
*.pyc
.venv/

# PyInstaller build output - the .exe files belong on a GitHub Release
# (binary downloads), never committed into git history/repo size
build/
dist/
# *.spec - NOT ignored: the three RealmReforged*.spec files are the build configs CI uses

# IDE / editor
.idea/
.vscode/
*.swp

# OS junk
Thumbs.db
desktop.ini
.DS_Store

# Agent workspace scaffolding - not part of the game
.agents/
.claude/
AGENTS.md
IDENTITY.md
SOUL.md
USER.md
skills-lock.json

# Player save data / runtime state - not source code
accounts/
achievements/
characters/
friends/
vaults/
crews/
# atomic-write temp files (saves are written to <name>.tmp then renamed)
*.tmp

# Local client settings (options menu)
settings.json
settings.json.tmp

# rendered zone music (game/music.py disk cache)
music_cache/

# local debug / profiling output and an unpacked Linux release
*.log
*.prof
RealmReforged-linux/
RealmReforged-linux-*.tar.gz
